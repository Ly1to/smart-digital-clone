# Docker Compose 部署配置。
# 使用方法：cp .env.example .env，然后至少填写 JWT_SECRET。
# 注意：这个文件供根目录 docker-compose.yml 使用；
# 本地直接运行后端时使用 backend/.env。

# 对外访问端口，默认 http://127.0.0.1:8080
APP_PORT=8080

# 应用时区，影响自动日程的 09:00–22:00 空闲时段计算，同时用于容器日志时间
APP_TIMEZONE=Asia/Shanghai

# 必填：JWT 签名密钥，至少 32 字节。
# 生成示例：openssl rand -base64 48
JWT_SECRET=

# 是否开放注册页。默认 true；设为 false 后前端隐藏注册入口，后端拒绝注册。
ALLOW_REGISTRATION=true

# 登录有效期，默认 10080 分钟（7 天）
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 可选：首次启动时自动创建唯一管理员账号（仅在 users 表为空时生效）
AUTH_BOOTSTRAP_USERNAME=
AUTH_BOOTSTRAP_PASSWORD=

# 可选：GitHub 自动来源
GITHUB_USERNAME=
GITHUB_TOKEN=
GITHUB_LOOKBACK_DAYS=14
GITHUB_API_URL=https://api.github.com
GITHUB_AUTO_SYNC_MINUTES=360

# 可选：Gitee 自动来源
GITEE_USERNAME=
GITEE_ACCESS_TOKEN=
GITEE_LOOKBACK_DAYS=14
GITEE_API_URL=https://gitee.com/api/v5
GITEE_AUTO_SYNC_MINUTES=360

# 自动插入日程的时间和时长
AUTO_SCHEDULE_DURATION_MINUTES=30
AUTO_SCHEDULE_DAY_START_HOUR=9
AUTO_SCHEDULE_DAY_END_HOUR=22
