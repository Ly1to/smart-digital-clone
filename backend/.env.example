# 数据库连接。默认使用仓库根目录 data/schedules.db
# DATABASE_URL=sqlite:///../data/schedules.db

# 开发环境允许访问的前端地址，JSON 数组格式
# CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# 登录与 JWT。生产环境务必设置固定的 JWT_SECRET；
# 未设置时每次进程启动会随机生成，重启后需要重新登录。
# JWT_SECRET=change-me-to-a-long-random-string
# ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 首次启动自动创建管理员账号（仅当 users 表为空时生效）。
# 也可以不配置，直接在登录页点击“创建管理员账号”。
# AUTH_BOOTSTRAP_USERNAME=admin
# AUTH_BOOTSTRAP_PASSWORD=change-me-123

# GitHub 自动来源。只同步公开仓库时可只填用户名；
# 私有仓库需要 GITHUB_TOKEN，Token 必须属于同一个 GitHub 账号。
# GITHUB_USERNAME=your-github-name
# GITHUB_TOKEN=github_pat_xxx
GITHUB_LOOKBACK_DAYS=14
GITHUB_API_URL=https://api.github.com
# 配置用户名后后台自动同步间隔（分钟），0 表示只手动同步
GITHUB_AUTO_SYNC_MINUTES=360

# Gitee 自动来源。公开仓库可只填用户名，私有仓库需要 GITEE_ACCESS_TOKEN。
# GITEE_USERNAME=your-gitee-name
# GITEE_ACCESS_TOKEN=your-access-token
GITEE_LOOKBACK_DAYS=14
GITEE_API_URL=https://gitee.com/api/v5
GITEE_AUTO_SYNC_MINUTES=360

# 自动日程插入今天空闲时间时的窗口和单条时长
AUTO_SCHEDULE_DURATION_MINUTES=30
AUTO_SCHEDULE_DAY_START_HOUR=9
AUTO_SCHEDULE_DAY_END_HOUR=22
